<?xml version="1.0" encoding="utf-8"?>
<!--
   Qué datos pueden salir del móvil en copias de seguridad (Android 12 o superior).
   Los documentos y fotos adjuntos (contratos, reconocimientos médicos, DNI…) contienen datos
   personales: no se suben a la nube ni se copian al pasar a otro móvil.
   Ver https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="adjuntos/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="adjuntos/" />
    </device-transfer>
</data-extraction-rules>
